            slice.len()
        };
        let (pushed, remainder) = slice.split_at(slots);
        // With MSRV 1.58, unwrap_unchecked() can be used.
        match self.push_entire_slice(pushed) {
            Ok(()) => {}
            // SAFETY: The requested slots are available.
            Err(_) => unsafe { core::hint::unreachable_unchecked() },
        };
        (pushed, remainder)
    }

    /// Copies all items from the given `slice` into the ring buffer.
    ///
    /// The written slots are automatically made available to be read by the [`Consumer`].
    ///
    /// To copy only into the available slots, [`Producer::push_partial_slice()`] can be used.
    ///
    /// # Errors
    ///
    /// If not enough free space is available in the ring buffer,
    /// a [`ChunkError`] with the available slots is returned.
{% if bip %}
    /// This number of slots might not be available in a contiguous chunk.
    pub fn push_entire_slice(&mut self, slice: &[T]) -> Result<(), ChunkError> {
        match self.write_chunk_uninit(slice.len()) {
            Ok(mut chunk) => {
                let dst = chunk.as_mut_slice();
                // NB: If slice.is_empty(), chunk will be empty as well and the following is a no-op:
                slice.copy_to_uninit(dst);
                // SAFETY: All slots have been initialized
                unsafe {
                    chunk.commit_all();
                }
                Ok(())
            },
            Err(e) => {
                // The given slice doesn't fit into a contiguous region,
                // but maybe it can be split into two parts?

                // At this point, `head` has already been refreshed and the cache is up to date.
                let (one, two) = self.cached_slots_contiguous();
                if slice.len() <= one + two {
                    let mut chunk = self.write_chunk_uninit(one).unwrap();
                    slice[..one].copy_to_uninit(chunk.as_mut_slice());
                    // SAFETY: All slots have been initialized
                    unsafe {
                        chunk.commit_all();
                    }
                    let mut chunk = self.write_chunk_uninit(two).unwrap();
                    slice[one..].copy_to_uninit(chunk.as_mut_slice());
                    // SAFETY: All slots have been initialized
                    unsafe {
                        chunk.commit_all();
                    }
                    Ok(())
                } else {
                    // TODO: return sum instead of max?
                    Err(e)
                }
            },
        }
    }
{% else %}
    pub fn push_entire_slice(&mut self, slice: &[T]) -> Result<(), ChunkError> {
        let mut chunk = self.write_chunk_uninit(slice.len())?;
        {% if storage == "vrb" %}
        let dst = chunk.as_mut_slice();
        // NB: If slice.is_empty(), chunk will be empty as well and the following is a no-op:
        slice.copy_to_uninit(dst);
        {% else %}
        let (one, two) = chunk.as_mut_slices();
        let mid = one.len();
        // NB: If slice.is_empty(), chunk will be empty as well and the following are no-ops:
        slice[..mid].copy_to_uninit(one);
        slice[mid..].copy_to_uninit(two);
        {% endif %}
        // SAFETY: All slots have been initialized
        unsafe {
            chunk.commit_all();
        }
        Ok(())
    }
{% endif %}
}
