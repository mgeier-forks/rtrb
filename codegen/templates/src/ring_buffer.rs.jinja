    /// Asserts that capacity is not too large and applies `update_capacity()`.
    const fn checked_capacity(capacity: usize) -> usize {
        assert!(
            {% if pow2 %}
            // Read/write indices use the whole range of `usize`,
            // half of that range can be used for slots.
            {% else %}
            // `2 * capacity` must not overflow.
            {% endif %}
            capacity <= {{ max_capacity }},
            "capacity exceeds {{ max_capacity }}"
        );
        Self::update_capacity(capacity)
    }

    /// Drop all elements that are still in the buffer.
    ///
    /// After this, head and tail indices are invalid.
    ///
    /// # Safety
    ///
    /// This can only be called in the `Drop` implementation of the ring buffer.
{% if arc %}
    ///
    /// The threads must have been synchronized before via `self.is_abandoned`.
{% endif %}
    #[inline(never)]
    unsafe fn drop_all_elements(&mut self) {
        // These atomic variables are *not* used for synchronizing the threads
        // before destruction.  Relaxed ordering is sufficient here.
        let mut head = self.head.load(Ordering::Relaxed);
        let tail = self.tail.load(Ordering::Relaxed);
{% if contiguous == "bip" %}
        let skip = self.skip.load(Ordering::Relaxed);
{% endif %}
        // Loop over all slots that hold a value and drop them.
        while head != tail {
{% if contiguous == "bip" %}
            if self.collapse_position(head) == skip {
                head = self.increment(head, self.capacity() - skip);
            }
{% endif %}
            // SAFETY: All slots between head and tail have been initialized.
            unsafe { self.slot_ptr(head).drop_in_place() };
            head = self.increment1(head);
        }
    }

{% if pow2 %}
    pub(super) fn collapse_position(&self, pos: usize) -> usize {
        // Wraps from any number to the range `0 .. capacity`.
        pos & (self.capacity() - 1)
    }
{% else %}
    pub(super) fn collapse_position(&self, pos: usize) -> usize {
        // Wraps from the range `0 .. 2 * capacity` to `0 .. capacity`.
        debug_assert!(pos == 0 || pos < 2 * self.capacity());
        if pos < self.capacity() {
            pos
        } else {
            pos - self.capacity()
        }
    }
{% endif %}

    /// Returns a pointer to the (possibly uninitialized) slot at position `pos`.
    ///
    /// # Safety
    ///
    /// `pos` must be valid.
    ///
    /// If `pos == 0 && capacity == 0`, the returned pointer must not be dereferenced!
    pub(super) unsafe fn slot_ptr(&self, pos: usize) -> *mut T {
        // SAFETY: See docstring.
        unsafe { self.data_ptr().add(self.collapse_position(pos)) }
    }

    /// Increments a position by going `n` slots forward.
{% if pow2 %}
    pub(super) fn increment(&self, pos: usize, n: usize) -> usize {
        pos.wrapping_add(n)
    }
{% else %}
    pub(super) fn increment(&self, pos: usize, n: usize) -> usize {
        debug_assert!(pos == 0 || pos < 2 * self.capacity());
        debug_assert!(n <= self.capacity());
        let threshold = 2 * self.capacity() - n;
        if pos < threshold {
            pos + n
        } else {
            pos - threshold
        }
    }
{% endif %}

    /// Increments a position by going one slot forward.
    ///
    /// This might be more efficient than self.increment(..., 1).
{% if pow2 %}
    pub(super) fn increment1(&self, pos: usize) -> usize {
        pos.wrapping_add(1)
    }
{% else %}
    pub(super) fn increment1(&self, pos: usize) -> usize {
        debug_assert_ne!(self.capacity(), 0);
        debug_assert!(pos < 2 * self.capacity());
        if pos < 2 * self.capacity() - 1 {
            pos + 1
        } else {
            0
        }
    }
{% endif %}

    /// Returns the distance between two positions.
{% if pow2 %}
    pub(super) fn distance(&self, a: usize, b: usize) -> usize {
        b.wrapping_sub(a)
    }
{% else %}
    pub(super) fn distance(&self, a: usize, b: usize) -> usize {
        debug_assert!(a == 0 || a < 2 * self.capacity());
        debug_assert!(b == 0 || b < 2 * self.capacity());
        if a <= b {
            b - a
        } else {
            2 * self.capacity() - a + b
        }
    }
{% endif %}

    pub(super) fn head(&self) -> usize {
        self.head.load(Ordering::Acquire)
    }

    pub(super) unsafe fn set_head(&self, value: usize) {
        self.head.store(value, Ordering::Release);
    }

    pub(super) fn tail(&self) -> usize {
        self.tail.load(Ordering::Acquire)
    }

    pub(super) unsafe fn set_tail(&self, value: usize) {
        self.tail.store(value, Ordering::Release);
    }
{% if contiguous == "bip" %}

    pub(super) fn skip(&self) -> usize {
        self.skip.load(Ordering::Relaxed)
    }

    pub(super) unsafe fn set_skip(&self, value: usize) {
        self.skip.store(value, Ordering::Relaxed);
    }
{% endif %}
{% if arc %}

    pub(super) unsafe fn abandon(&self) -> bool {
        // The "store" part of `swap()` has to use `Release` to make sure that any previous writes
        // to the ring buffer happen before it (in the thread that drops first).
        // The "load" part can be `Relaxed` for the first thread,
        // but it must be `Acquire` for the second one (see below).
        if self.is_abandoned.swap(true, Ordering::Release) {
            // The flag was already set, i.e. the other thread has already dropped its
            // consumer/producer and it can be dropped now.

            // However, since the load of `flags` was `Relaxed`,
            // we have to use `Acquire` here to make sure that reading `head` and `tail`
            // in the destructor happens after this point.

            // Ideally, we would use a memory fence like this:
            //core::sync::atomic::fence(Ordering::Acquire);
            // ... but as long as ThreadSanitizer doesn't support fences,
            // we use load(Acquire) as a work-around to avoid false positives:
            let _ = self.is_abandoned.load(Ordering::Acquire);
            true
        } else {
            // The flag wasn't set before, so we are the first to drop our
            // producer/consumer and it should not be dropped yet.
            false
        }
    }

    pub(super) fn is_abandoned(&self) -> bool {
        self.is_abandoned.load(Ordering::Acquire)
    }
{% else %}

    pub(super) fn drop_producer(&self) {
        self.has_producer.store(false, Ordering::Release);
    }

    pub(super) fn drop_consumer(&self) {
        self.has_consumer.store(false, Ordering::Release);
    }
{% endif %}
}
{% if not arc %}

// SAFETY: If T can be moved between threads, ArrayRingBuffer can as well.
unsafe impl<T: Send, const N: usize> Send for ArrayRingBuffer<T, N> {}

impl<T, const N: usize> ArrayRingBuffer<T, N> {
    /// Creates a ring buffer with a capacity of `N`.
    ///
{% if pow2 %}
    /// `N` must be a power of two.
    ///
{% endif %}
    /// `N` cannot be larger than `{{ max_capacity }}`.
    ///
    /// A (single) [`Producer`] for writing into the ring buffer can be created with
    /// [`RingBuffer::producer()`].
    /// A (single) [`Consumer`] for reading from the ring buffer can be created with
    /// [`RingBuffer::consumer()`].
    ///
    /// # Examples
    ///
    /// ```
    /// use {{ module_path }}::ArrayRingBuffer;
    ///
    /// let rb = ArrayRingBuffer::<f32, 128>::new();
    /// ```
    ///
    /// Specifying an explicit type is is only necessary if it cannot be deduced by the compiler.
    ///
    /// ```
    /// use {{ module_path }}::ArrayRingBuffer;
    ///
    /// let rb = ArrayRingBuffer::<_, 128>::new();
    /// let mut producer = rb.producer().unwrap();
    /// assert_eq!(producer.push(0.0f32), Ok(()));
    /// ```
    ///
    /// See the [module-level documentation](crate::{{ module_name }}) for `static` usage.
    pub const fn new() -> Self {
        const {
{% if pow2 %}
            assert!(
                RingBuffer::<T>::checked_capacity(N) == N,
                "`N` must be a power of two"
            );
{% else %}
            RingBuffer::<T>::checked_capacity(N);
{% endif %}
        }
        Self::from_sized_fields(RingBuffer::<T>::initial_values({% if contiguous == "bip" %}N{% endif %}))
    }
}

impl<T, const N: usize> Default for ArrayRingBuffer<T, N> {
    fn default() -> Self {
        Self::new()
    }
}

impl<T, const N: usize> core::ops::Deref for ArrayRingBuffer<T, N> {
    type Target = RingBuffer<T>;

    fn deref(&self) -> &Self::Target {
        self.as_unsized()
    }
}

impl<T, const N: usize> core::ops::DerefMut for ArrayRingBuffer<T, N> {
    fn deref_mut(&mut self) -> &mut Self::Target {
        self.as_unsized_mut()
    }
}

impl<T, const N: usize> Drop for ArrayRingBuffer<T, N> {
    /// Drops all non-empty slots.
    fn drop(&mut self) {
        // SAFETY: this is called exactly once, no references to any elements exist anymore.
        unsafe { self.as_unsized_mut().drop_all_elements() };
    }
}
{% endif %}
