{% macro doctest_create_ring_buffer(capacity, prefix="    ///") %}
{% if arc %}
{{ prefix }} let (mut producer, mut consumer) = RingBuffer::new({{ capacity }});
{%- else %}
{{ prefix }} let rb = RingBuffer::new({{ capacity }});
{{ prefix }} let mut producer = rb.producer().unwrap();
{{ prefix }} let mut consumer = rb.consumer().unwrap();
{% endif %}
{%- endmacro %}
