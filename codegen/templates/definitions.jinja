{% macro CachePadded(arg) %}
{% if padded %}CachePadded<{{ arg }}>{% else %}{{ arg }}{% endif %}
{% endmacro %}
{##}
{% macro CachePadded_new(arg) %}
{% if padded %}CachePadded::new({{ arg }}){% else %}{{ arg }}{% endif %}
{% endmacro %}
